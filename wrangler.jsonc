{
  "name": "eddyshao",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "workers/app.ts",
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_dir": "app"
  }
}
